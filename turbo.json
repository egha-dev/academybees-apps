{
  "$schema": "https://turborepo.com/schema.json",
  "agentGuidance": false,
  "ui": "stream",
  "globalDependencies": [".nvmrc", "pnpm-workspace.yaml"],
  "globalEnv": ["APP_ENV", "NODE_ENV", "CI"],
  "tasks": {
    "generate": {
      "dependsOn": ["^generate"],
      "inputs": ["prisma/**", "prisma.config.ts"],
      "outputs": ["src/generated/**"]
    },
    "build": {
      "dependsOn": ["^build", "generate"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "lint": {
      "outputs": [],
      "dependsOn": ["^generate", "generate"]
    },
    "typecheck": {
      "outputs": [],
      "dependsOn": ["^generate", "generate"]
    },
    "test": {
      "outputs": [],
      "dependsOn": ["^generate", "generate"]
    },
    "test:integration": {
      "dependsOn": ["^generate", "generate"],
      "outputs": [],
      "cache": false
    },
    "dev": {
      "dependsOn": ["^build", "generate"],
      "cache": false,
      "persistent": true
    }
  },
  "envMode": "loose"
}
