// Identity, membership and sessions (Phase 2, ADR-006/007, ARCHITECTURE §6.1).
// One global identity (User) with many tenant memberships. Identity rows are user-owned (RLS keyed
// on `app.user_id`, C-59); memberships and roles are tenant-owned (standard tenant RLS).
// Phone-ready (C-65): email or phone may be the only identifier; OTP sending arrives in Phase 10.

enum UserStatus {
  ACTIVE
  DISABLED

  @@map("user_status")
}

/// A person. Email is stored lower-cased (CHECK), phone in E.164; at least one is required (CHECK).
model User {
  id              String     @id @db.Uuid
  email           String?    @unique @db.VarChar(320)
  phone           String?    @unique @db.VarChar(16)
  name            String     @db.VarChar(120)
  status          UserStatus @default(ACTIVE)
  emailVerifiedAt DateTime?  @map("email_verified_at") @db.Timestamptz(3)
  /// A phone becomes a login identifier only once verified (C-65).
  phoneVerifiedAt DateTime?  @map("phone_verified_at") @db.Timestamptz(3)
  /// BCP-47; null = academy default → en-IN (ADR-040). Always en-IN until Phase L.
  preferredLocale String?    @map("preferred_locale") @db.VarChar(20)
  lastLoginAt     DateTime?  @map("last_login_at") @db.Timestamptz(3)
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  credential       UserCredential?
  memberships      Membership[]
  platformStaff    PlatformStaff?
  sessions         AuthSession[]
  resetTokens      PasswordResetToken[]
  mfaFactors       MfaFactor[]
  mfaRecoveryCodes MfaRecoveryCode[]
  knownDevices     KnownDevice[]

  @@map("user")
}

/// Password (argon2id) and lockout state. Never returned by any API.
model UserCredential {
  userId            String    @id @map("user_id") @db.Uuid
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  passwordHash      String    @map("password_hash") @db.VarChar(255)
  passwordUpdatedAt DateTime  @default(now()) @map("password_updated_at") @db.Timestamptz(3)
  failedCount       Int       @default(0) @map("failed_count")
  lockedUntil       DateTime? @map("locked_until") @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("user_credential")
}

enum MembershipStatus {
  INVITED
  ACTIVE
  DISABLED

  @@map("membership_status")
}

/// A user's place in one academy. Roles grant capabilities with scopes (ADR-008).
model Membership {
  id                 String           @id @db.Uuid
  tenantId           String           @map("tenant_id") @db.Uuid
  tenant             Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  userId             String           @map("user_id") @db.Uuid
  user               User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  status             MembershipStatus @default(INVITED)
  /// Branches this membership is limited to (BRANCH scope); empty = all branches.
  branchIds          String[]         @default([]) @map("branch_ids") @db.Uuid
  /// Bumped on every role/status change: invalidates cached capabilities immediately (ARCHITECTURE §6.2).
  permissionsVersion Int              @default(1) @map("permissions_version")
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  roles MembershipRole[]

  @@unique([tenantId, userId])
  @@unique([tenantId, id])
  @@index([userId])
  @@map("membership")
}

enum RoleScope {
  TENANT
  BRANCH
  ASSIGNED
  LINKED
  SELF

  @@map("role_scope")
}

/// An academy's role, copied from the code templates in @academybee/contracts (C-60).
model Role {
  id        String   @id @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  /// Template key (owner, admin, teacher, …) or a custom key later (`role.manage`).
  key       String   @db.VarChar(40)
  name      String   @db.VarChar(80)
  isSystem  Boolean  @default(true) @map("is_system")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  permissions RolePermission[]
  memberships MembershipRole[]

  @@unique([tenantId, key])
  @@unique([tenantId, id])
  @@map("role")
}

/// One capability of a role, with the scope it applies in (ARCHITECTURE §7.2).
model RolePermission {
  tenantId   String    @map("tenant_id") @db.Uuid
  roleId     String    @map("role_id") @db.Uuid
  role       Role      @relation(fields: [tenantId, roleId], references: [tenantId, id], onDelete: Cascade)
  capability String    @db.VarChar(80)
  scope      RoleScope

  @@id([roleId, capability])
  @@index([tenantId])
  @@map("role_permission")
}

model MembershipRole {
  tenantId     String     @map("tenant_id") @db.Uuid
  membershipId String     @map("membership_id") @db.Uuid
  membership   Membership @relation(fields: [tenantId, membershipId], references: [tenantId, id], onDelete: Cascade)
  roleId       String     @map("role_id") @db.Uuid
  role         Role       @relation(fields: [tenantId, roleId], references: [tenantId, id], onDelete: Restrict)

  @@id([membershipId, roleId])
  @@index([tenantId])
  @@map("membership_role")
}

enum PlatformRole {
  SUPER_ADMIN
  SUPPORT
  FINANCE_OPS

  @@map("platform_role")
}

enum PlatformStaffStatus {
  ACTIVE
  DISABLED

  @@map("platform_staff_status")
}

/// AcademyBee staff who may use the console (C-02). Created by `pnpm platform:create-admin`;
/// console sign-in needs password + TOTP (C-66).
model PlatformStaff {
  userId       String              @id @map("user_id") @db.Uuid
  user         User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  platformRole PlatformRole        @map("platform_role")
  status       PlatformStaffStatus @default(ACTIVE)
  createdAt    DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("platform_staff")
}

enum SessionAudience {
  TENANT
  CONSOLE
  HUB

  @@map("session_audience")
}

/// A signed-in device. `tenantId` only for TENANT sessions (C-32). Refresh tokens rotate within a
/// family; presenting a rotated token revokes the family (reuse detection, ADR-007).
model AuthSession {
  id               String          @id @db.Uuid
  userId           String          @map("user_id") @db.Uuid
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenantId         String?         @map("tenant_id") @db.Uuid
  audience         SessionAudience
  familyId         String          @map("family_id") @db.Uuid
  refreshTokenHash String          @unique @map("refresh_token_hash") @db.Char(64)
  deviceLabel      String?         @map("device_label") @db.VarChar(120)
  ip               String?         @db.VarChar(64)
  userAgent        String?         @map("user_agent") @db.VarChar(300)
  mfaVerifiedAt    DateTime?       @map("mfa_verified_at") @db.Timestamptz(3)
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  lastUsedAt       DateTime        @default(now()) @map("last_used_at") @db.Timestamptz(3)
  expiresAt        DateTime        @map("expires_at") @db.Timestamptz(3)
  revokedAt        DateTime?       @map("revoked_at") @db.Timestamptz(3)
  revokeReason     String?         @map("revoke_reason") @db.VarChar(40)

  @@index([userId, revokedAt])
  @@index([familyId])
  @@map("auth_session")
}

/// Invitation to join an academy with roles. Accepted on the academy host (or the Family Hub for
/// parents, Phase 4/7P). The secret is stored only as a hash.
model Invitation {
  id             String    @id @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  email          String?   @db.VarChar(320)
  phone          String?   @db.VarChar(16)
  roleKeys       String[]  @map("role_keys") @db.VarChar(40)
  tokenHash      String    @unique @map("token_hash") @db.Char(64)
  invitedById    String?   @map("invited_by_id") @db.Uuid
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(3)
  acceptedAt     DateTime? @map("accepted_at") @db.Timestamptz(3)
  acceptedUserId String?   @map("accepted_user_id") @db.Uuid
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([tenantId, createdAt])
  @@map("invitation")
}

model PasswordResetToken {
  id        String    @id @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([userId])
  @@map("password_reset_token")
}

enum MfaFactorType {
  TOTP

  @@map("mfa_factor_type")
}

/// Second factor (G-11; mandatory for platform staff, C-66). The secret is envelope-encrypted.
model MfaFactor {
  id              String        @id @db.Uuid
  userId          String        @map("user_id") @db.Uuid
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  type            MfaFactorType
  secretEncrypted String        @map("secret_encrypted") @db.Text
  confirmedAt     DateTime?     @map("confirmed_at") @db.Timestamptz(3)
  lastUsedAt      DateTime?     @map("last_used_at") @db.Timestamptz(3)
  /// Last accepted TOTP time step, so a code can't be replayed within its window.
  lastStep        BigInt?       @map("last_step")
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([userId, type])
  @@map("mfa_factor")
}

model MfaRecoveryCode {
  id        String    @id @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String    @map("code_hash") @db.Char(64)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([userId])
  @@map("mfa_recovery_code")
}

/// Devices that have signed in before (new-device alerts, G-11). Keyed by a hashed device cookie.
model KnownDevice {
  id           String   @id @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceIdHash String   @map("device_id_hash") @db.Char(64)
  label        String?  @db.VarChar(120)
  firstSeenAt  DateTime @default(now()) @map("first_seen_at") @db.Timestamptz(3)
  lastSeenAt   DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(3)

  @@unique([userId, deviceIdHash])
  @@map("known_device")
}

enum OtpChannel {
  SMS
  WHATSAPP

  @@map("otp_channel")
}

enum OtpPurpose {
  LOGIN
  VERIFY_PHONE

  @@map("otp_purpose")
}

/// One-time code sent to a phone (C-65). Designed now, used from Phase 10 (SMS/WhatsApp, DLT).
model OtpChallenge {
  id             String     @id @db.Uuid
  /// SHA-256 of the normalised identifier — the table never stores the phone itself.
  identifierHash String     @map("identifier_hash") @db.Char(64)
  channel        OtpChannel
  purpose        OtpPurpose
  codeHash       String     @map("code_hash") @db.Char(64)
  attempts       Int        @default(0)
  expiresAt      DateTime   @map("expires_at") @db.Timestamptz(3)
  consumedAt     DateTime?  @map("consumed_at") @db.Timestamptz(3)
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([identifierHash, createdAt])
  @@map("otp_challenge")
}
