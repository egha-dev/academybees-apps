{
  "name": "@academybee/contracts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Zod contracts shared by web, API and worker: errors, pagination, permissions, sync ops, analytics events, IDs.",
  "sideEffects": false,
  "exports": {
    ".": {
      "@academybee/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "flags:check": "tsx scripts/check-flags.ts"
  },
  "dependencies": {
    "uuid": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@academybee/config": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
