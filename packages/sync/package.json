{
  "name": "@academybee/sync",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Offline storage and sync engine: Dexie database, sync queue, backoff, connectivity, Web Lock runner and React hooks (ADR-016, ARCHITECTURE §11).",
  "sideEffects": false,
  "exports": {
    ".": {
      "@academybee/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "@academybee/source": "./src/react/index.ts",
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@academybee/contracts": "workspace:*",
    "dexie": "catalog:"
  },
  "peerDependencies": {
    "react": "*"
  },
  "devDependencies": {
    "@academybee/config": "workspace:*",
    "@testing-library/react": "catalog:",
    "@testing-library/dom": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "eslint": "catalog:",
    "fake-indexeddb": "catalog:",
    "jsdom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
