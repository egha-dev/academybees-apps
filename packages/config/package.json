{
  "name": "@academybee/config",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Shared tsconfig bases, ESLint flat config, Prettier config and Vitest presets.",
  "exports": {
    "./tsconfig/*": "./tsconfig/*",
    "./eslint": {
      "types": "./eslint/index.d.ts",
      "default": "./eslint/index.js"
    },
    "./prettier": "./prettier/index.js",
    "./vitest": {
      "types": "./vitest/index.d.ts",
      "default": "./vitest/index.js"
    }
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@eslint/js": "catalog:",
    "eslint-config-prettier": "catalog:",
    "eslint-import-resolver-typescript": "catalog:",
    "eslint-plugin-boundaries": "catalog:",
    "globals": "catalog:",
    "typescript-eslint": "catalog:",
    "unplugin-swc": "catalog:",
    "@swc/core": "catalog:"
  },
  "peerDependencies": {
    "eslint": "*",
    "vitest": "*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
