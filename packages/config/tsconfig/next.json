{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "AcademyBee Next.js application",
  "extends": "./base.json",
  "compilerOptions": {
    "lib": ["ES2024", "DOM", "DOM.Iterable", "WebWorker"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "preserve",
    "allowJs": false,
    "noEmit": true,
    "incremental": true,
    "sourceMap": false,
    "plugins": [{ "name": "next" }]
  }
}
