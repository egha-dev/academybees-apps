{
  "name": "@academybee/tenant",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Hostname normalisation and classification, slug rules and reserved names — shared by the web proxy and the API (ADR-003, ARCHITECTURE §4.1, §5.2).",
  "sideEffects": false,
  "exports": {
    ".": {
      "@academybee/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@academybee/config": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "fast-check": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
