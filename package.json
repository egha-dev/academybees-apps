{
  "name": "academybee",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=24.11 <25",
    "pnpm": ">=12.8"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration --concurrency=1",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "lefthook install",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d --wait postgres redis mailpit s3 && docker compose -f infra/docker-compose.yml run --rm s3-init",
    "infra:down": "docker compose -f infra/docker-compose.yml down",
    "infra:reset": "docker compose -f infra/docker-compose.yml down -v && pnpm infra:up",
    "infra:logs": "docker compose -f infra/docker-compose.yml logs -f",
    "env:init": "scripts/dev/init-env.sh",
    "db:migrate": "pnpm --filter @academybee/database db:migrate",
    "db:deploy": "pnpm --filter @academybee/database db:deploy",
    "db:seed": "pnpm --filter @academybee/database db:seed",
    "db:drift": "pnpm --filter @academybee/database db:drift",
    "db:generate": "turbo run generate",
    "platform:create-admin": "turbo run build --filter=@academybee/api --output-logs=errors-only && pnpm --filter @academybee/api platform:create-admin",
    "i18n:check": "pnpm --filter @academybee/i18n i18n:check",
    "i18n:pseudo": "pnpm --filter @academybee/i18n i18n:pseudo",
    "e2e": "pnpm build && pnpm --filter @academybee/web build:pseudo && pnpm --filter @academybee/e2e e2e",
    "e2e:run": "pnpm --filter @academybee/e2e e2e",
    "perf:budget": "node scripts/perf/bundle-budget.mjs",
    "perf:lighthouse": "lhci autorun --config=lighthouserc.cjs",
    "flags:check": "pnpm --filter @academybee/contracts flags:check"
  },
  "devDependencies": {
    "@academybee/config": "workspace:*",
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@lhci/cli": "catalog:",
    "@types/node": "catalog:",
    "lefthook": "catalog:",
    "lint-staged": "catalog:",
    "prettier": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  },
  "browserslist": [
    "chrome >= 109",
    "and_chr >= 109",
    "edge >= 109",
    "firefox >= 128",
    "safari >= 16.4",
    "ios_saf >= 16.4"
  ]
}
