# apps/web — local development. Copy to .env.local (`pnpm env:init`).
APP_ENV=local

# The web tier rewrites /api/* to this origin and forwards the host (ARCHITECTURE §4.2).
API_ORIGIN=http://localhost:4000
TRUSTED_PROXY_SECRET=local-proxy-secret

# Root domain academy subdomains live under (C-52): localhost | staging.academybees.com | academybees.com.
PLATFORM_ROOT_DOMAIN=localhost
# Platform header carrying the real client IP (Vercel: x-real-ip). Empty locally: the API then uses
# the socket address. Client-sent X-Forwarded-For is always dropped (review M1).
TRUSTED_CLIENT_IP_HEADER=
# Custom academy domains (PRD v3.1 §G) — off until that feature ships; same value as the API.
CUSTOM_DOMAINS_ENABLED=false

# Pseudo-locale / long-text builds for i18n checks (G-32): en-XA or en-LONG. Leave empty normally.
NEXT_PUBLIC_LOCALE_OVERRIDE=

# Error tracking (C-48): both empty = off. The browser DSN is fixed at build time.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_APP_ENV=local
SENTRY_DSN=
