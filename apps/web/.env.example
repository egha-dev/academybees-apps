# apps/web — local development. Copy to .env.local (`pnpm env:init`).
APP_ENV=local

# The web tier rewrites /api/* to this origin and forwards the host (ARCHITECTURE §4.2).
API_ORIGIN=http://localhost:4000
TRUSTED_PROXY_SECRET=local-proxy-secret

# Root domain academy subdomains live under (C-52): localhost | staging.academybee.com | academybee.com.
PLATFORM_ROOT_DOMAIN=localhost

# Pseudo-locale / long-text builds for i18n checks (G-32): en-XA or en-LONG. Leave empty normally.
NEXT_PUBLIC_LOCALE_OVERRIDE=

# Error tracking (C-48): both empty = off. The browser DSN is fixed at build time.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_APP_ENV=local
SENTRY_DSN=
