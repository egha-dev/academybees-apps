{
  "name": "@academybee/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "AcademyBee API — NestJS modular monolith (ADR-001).",
  "scripts": {
    "build": "swc src -d dist --strip-leading-paths --ignore \"**/*.spec.ts\"",
    "dev": "swc src -d dist --strip-leading-paths --ignore \"**/*.spec.ts\" && concurrently -k -n swc,api \"swc src -d dist --strip-leading-paths --ignore \\\"**/*.spec.ts\\\" -w\" \"node --watch-path=dist --env-file-if-exists=.env dist/main.js\"",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "platform:create-admin": "node --env-file-if-exists=.env dist/platform/cli/create-admin.js"
  },
  "dependencies": {
    "@academybee/auth": "workspace:*",
    "@academybee/contracts": "workspace:*",
    "@academybee/database": "workspace:*",
    "@academybee/i18n": "workspace:*",
    "@academybee/tenant": "workspace:*",
    "@nestjs/common": "catalog:",
    "@nestjs/core": "catalog:",
    "@nestjs/platform-express": "catalog:",
    "@sentry/node": "catalog:",
    "express": "catalog:",
    "ioredis": "catalog:",
    "nestjs-cls": "catalog:",
    "nestjs-pino": "catalog:",
    "pino": "catalog:",
    "pino-http": "catalog:",
    "reflect-metadata": "catalog:",
    "rxjs": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@academybee/config": "workspace:*",
    "@academybee/testing": "workspace:*",
    "@nestjs/testing": "catalog:",
    "@swc/cli": "catalog:",
    "@swc/core": "catalog:",
    "@types/express": "catalog:",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "@types/supertest": "catalog:",
    "concurrently": "catalog:",
    "eslint": "catalog:",
    "pg": "catalog:",
    "pino-pretty": "catalog:",
    "supertest": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
