# apps/api — local development. Copy to .env (`pnpm env:init`). Never commit real secrets.
APP_ENV=local
NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

# PostgreSQL: the app role has no BYPASSRLS (ADR-005). The platform role is for src/platform/** only.
DATABASE_URL=postgresql://ab_app:ab_app_local@localhost:5432/academybee
PLATFORM_DATABASE_URL=postgresql://ab_platform:ab_platform_local@localhost:5432/academybee

REDIS_URL=redis://localhost:6379

# X-Forwarded-Host is trusted only from these proxies, or with this shared secret (ARCHITECTURE §4.2).
TRUSTED_PROXY_IPS=127.0.0.1,::1,::ffff:127.0.0.1
TRUSTED_PROXY_SECRET=local-proxy-secret

# Product analytics (ADR-032, OD-14): no-op adapter unless POSTHOG_API_KEY is set; always no-op in ci.
POSTHOG_API_KEY=
POSTHOG_HOST=https://eu.i.posthog.com
ANALYTICS_HASH_SALT=local-analytics-salt

# Error tracking (OD-21): disabled while empty.
SENTRY_DSN=
