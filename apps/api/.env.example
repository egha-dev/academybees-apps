# apps/api — local development. Copy to .env (`pnpm env:init`). Never commit real secrets.
APP_ENV=local
NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

# PostgreSQL: the app role has no BYPASSRLS (ADR-005). The platform role is for src/platform/** only.
DATABASE_URL=postgresql://ab_app:ab_app_local@localhost:5432/academybee
PLATFORM_DATABASE_URL=postgresql://ab_platform:ab_platform_local@localhost:5432/academybee

REDIS_URL=redis://localhost:6379

# X-Forwarded-Host is trusted only from these proxies, or with this shared secret (ARCHITECTURE §4.2).
TRUSTED_PROXY_IPS=127.0.0.1,::1,::ffff:127.0.0.1
TRUSTED_PROXY_SECRET=local-proxy-secret
# Root domain academy subdomains live under (C-52): localhost | staging.academybees.com | academybees.com.
PLATFORM_ROOT_DOMAIN=localhost
# Custom academy domains (PRD v3.1 §G) — off until that feature ships; same value as the web.
CUSTOM_DOMAINS_ENABLED=false

# Sessions (ADR-007, C-64). `pnpm env:init` generates both locally; use secret-store values elsewhere.
# AUTH_SIGNING_KEYS: {"current":"<kid>","keys":[<Ed25519 private JWKs with kid>]} — rotate by adding a key.
AUTH_SIGNING_KEYS=
# SECRETS_MASTER_KEY: <id>:<base64 32 bytes>[,<old id>:<key>] — must equal the worker's value.
SECRETS_MASTER_KEY=
# Cookie names/flags: `secure` (__Host-/__Secure-) everywhere https is used. Local http://*.localhost
# needs `insecure-dev`: Safari/WebKit drops Secure cookies on plain http (S6 spike, C-64, C-68).
# The API refuses insecure-dev outside local/ci.
COOKIE_MODE=insecure-dev

# Console host allow-list (C-66, C-73): IPs/CIDRs, comma-separated; empty = none (local/ci).
CONSOLE_IP_ALLOWLIST=

# Product analytics (ADR-032, OD-14): no-op adapter unless POSTHOG_API_KEY is set; always no-op in ci.
POSTHOG_API_KEY=
POSTHOG_HOST=https://eu.i.posthog.com
ANALYTICS_HASH_SALT=local-analytics-salt

# Error tracking (OD-21): disabled while empty.
SENTRY_DSN=

# Object storage (C-97): local SeaweedFS from `pnpm infra:up`; Cloudflare R2 on staging/production.
MEDIA_S3_ENDPOINT=http://localhost:8333
MEDIA_S3_REGION=auto
MEDIA_S3_ACCESS_KEY_ID=academybee
MEDIA_S3_SECRET_ACCESS_KEY=academybee-local-secret
MEDIA_PUBLIC_BUCKET=academybee-local
MEDIA_PUBLIC_BASE_URL=http://localhost:8333/academybee-local
