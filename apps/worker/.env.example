# apps/worker — local development. Copy to .env (`pnpm env:init`).
APP_ENV=local
NODE_ENV=development
LOG_LEVEL=debug

DATABASE_URL=postgresql://ab_app:ab_app_local@localhost:5432/academybee
# Platform role — only for cross-tenant platform jobs such as the outbox relay (src/platform/**).
PLATFORM_DATABASE_URL=postgresql://ab_platform:ab_platform_local@localhost:5432/academybee
REDIS_URL=redis://localhost:6379

# Outbox relay (ADR-019)
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=100

# Decrypts secrets the API sealed (C-62); must equal the API's value. Generated by `pnpm env:init`.
SECRETS_MASTER_KEY=

# Transactional email (C-04): Mailpit locally (http://localhost:8025).
SMTP_URL=smtp://localhost:1025
EMAIL_FROM=AcademyBee <no-reply@academybees.test>
# Links in emails point to the web app: http://<slug>.localhost:3000 locally.
PLATFORM_ROOT_DOMAIN=localhost
WEB_PUBLIC_PROTOCOL=http
WEB_PUBLIC_PORT=3000

POSTHOG_API_KEY=
POSTHOG_HOST=https://eu.i.posthog.com
ANALYTICS_HASH_SALT=local-analytics-salt

SENTRY_DSN=
