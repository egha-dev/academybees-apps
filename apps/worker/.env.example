# apps/worker — local development. Copy to .env (`pnpm env:init`).
APP_ENV=local
NODE_ENV=development
LOG_LEVEL=debug

DATABASE_URL=postgresql://ab_app:ab_app_local@localhost:5432/academybee
REDIS_URL=redis://localhost:6379

# Outbox relay (ADR-019)
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=100

POSTHOG_API_KEY=
POSTHOG_HOST=https://eu.i.posthog.com
ANALYTICS_HASH_SALT=local-analytics-salt

SENTRY_DSN=
